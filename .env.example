# Modelo padronizado de variaveis de ambiente — meu-agente (base canonica).
# Copie para `.env` (raiz) e para `orchestrator/.env` (o compose canonico le
# o .env do orquestrador via env_file; as chaves ORCHESTRATOR_* valem pros
# dois). Nunca commite nenhum `.env` real — todos sao gitignored.
# Todos os valores abaixo sao PLACEHOLDERS.

# --- Imagem / portas (compose canonico docker-compose.yml) ---
# Tag da imagem do orquestrador (default: build local).
ORCHESTRATOR_IMAGE=meu-agente-orchestrator:local
# Porta publicada no host (mapeada para 8000 do container).
ORCHESTRATOR_HOST_PORT=8000
# URL do gateway OpenClaw vista DE DENTRO do container do orquestrador
# (nome do container na rede compartilhada meu-agente-net).
ORCHESTRATOR_OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789

# --- API do orquestrador (orchestrator/src/orchestrator/config.py) ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000

# --- Gateway OpenClaw (Especialista em Programacao) ---
# Bearer [REDACTED] em POST /v1/chat. Deve ser identico ao token do gateway
# (OPENCLAW_GATEWAY_TOKEN, no .env do host do gateway — nunca aqui).
ORCHESTRATOR_OPENCLAW_GATEWAY_TOKEN=
ORCHESTRATOR_OPENCLAW_AGENT_MODEL=openclaw/default
# Deve ser MENOR que ORCHESTRATOR_TURN_TIMEOUT_SEC (margem de 30s).
ORCHESTRATOR_OPENCLAW_REQUEST_TIMEOUT_SEC=120

# --- n8n (Especialista de Automacao / Modo Executor) ---
# Producao: URL publica da instancia externa. Testes locais com o compose
# auxiliar: http://n8n:5678 (docker-compose.n8n.yml).
ORCHESTRATOR_N8N_URL=https://n8n.example.com
# API key da REST /api/v1 + webhook (header X-N8N-KEY).
ORCHESTRATOR_N8N_API_KEY=
ORCHESTRATOR_N8N_REQUEST_TIMEOUT_SEC=30
# Janela de validade de uma proposta de escrita (create/activate/deactivate/
# delete) aguardando confirmacao do usuario. 900s = 15min.
ORCHESTRATOR_N8N_CONFIRMATION_TTL_SEC=900

# --- Modo Atendente (resposta conversacional + transbordo humano) ---
# Perfil padrao do orquestrador: "atendente" (conversacional, com transbordo
# humano via ask_human/escalate_to_human) ou "executor" (automacao via n8n).
ORCHESTRATOR_ATTENDANT_MODE=atendente
# Operador humano de destino do transbordo (transbordo via plugin ask-max no
# gateway; aqui ficam os mesmos valores como referencia/documentacao do par).
# Nome de exibicao do operador (usado na mensagem de escalonamento).
ASKMAX_OPERATOR_NAME=Max
# Numero/contato do operador no canal (ex.: WhatsApp com DDI+DDD, so digitos).
ASKMAX_OPERATOR_TO=5541999999999
# Canal de entrega do transbordo (id do canal no gateway).
ASKMAX_CHANNEL=whatsapp-cloud
# Conta do canal, quando houver mais de uma (opcional).
ASKMAX_ACCOUNT_ID=

# --- Roteador / resposta direta (via OpenRouter) ---
ORCHESTRATOR_OPENROUTER_API_KEY=
ORCHESTRATOR_ROUTER_MODEL=deepseek/deepseek-chat
ORCHESTRATOR_GENERAL_MODEL=deepseek/deepseek-chat

# --- Grafo / endpoint sincrono ---
ORCHESTRATOR_MAX_SUPERVISOR_ITERATIONS=4
# Tempo maximo de /v1/turn antes do fallback 200.
ORCHESTRATOR_TURN_TIMEOUT_SEC=150

# --- Checkpointing ---
ORCHESTRATOR_CHECKPOINTER_SQLITE_PATH=./data/checkpoints.sqlite

# --- Observabilidade (LangSmith, desligado por padrao) ---
ORCHESTRATOR_LANGCHAIN_TRACING_V2=false
ORCHESTRATOR_LANGCHAIN_API_KEY=
ORCHESTRATOR_LANGCHAIN_PROJECT=orchestrator-portfolio

# --- n8n local de testes (docker-compose.n8n.yml, opcional) ---
N8N_VERSION=latest
N8N_HOST_PORT=5678
N8N_TIMEZONE=America/Sao_Paulo
N8N_WEBHOOK_URL=http://localhost:5678/
