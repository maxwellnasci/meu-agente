# Modelo padronizado de variáveis de ambiente — meu-agente
# Copie para `.env` (nunca commite o `.env` real — ele é gitignored).
# Todos os valores abaixo são PLACEHOLDERS. Nenhum segredo real deve
# aparecer neste arquivo.
#
# Seção 1: Orquestrador Python (FastAPI/LangGraph).
# Lidas por `orchestrator/src/orchestrator/config.py`
# (`Settings`, `env_prefix="ORCHESTRATOR_"`, `env_file=".env"`).
# O compose monta `orchestrator/.env` via `env_file` — este exemplo
# vive ao lado dele, em `orchestrator/.env.example`.

# --- API do orquestrador ---
# Host/porta de escuta dentro do container (o compose publica via
# ORCHESTRATOR_HOST_PORT abaixo).
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
# Token de autenticacao dos endpoints protegidos (/v1/turn, /tasks/stream),
# validado em main.py:verify_api_token via `Authorization: Bearer <token>`
# (ou header `X-Orchestrator-Token`). Deve ser identico no cliente Node
# (ORCHESTRATOR_API_TOKEN no env do gateway) e no scripts/eval-router.py
# (--token ou env). Vazio/não definido = modo dev SEM autenticação (o
# startup emite warning explícito nesse caso; nunca usar em produção).
ORCHESTRATOR_API_TOKEN=

# --- Gateway OpenClaw (Especialista em Programação) ---
# URL base do gateway. Local: http://localhost:18789 ; dentro do
# container (rede do gateway): http://openclaw-gateway:18789
ORCHESTRATOR_OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
# Bearer usado em `POST /v1/chat` (clients/openclaw_client.py).
# Deve ser idêntico ao token do gateway (OPENCLAW_GATEWAY_TOKEN).
ORCHESTRATOR_OPENCLAW_GATEWAY_TOKEN=
ORCHESTRATOR_OPENCLAW_AGENT_MODEL=openclaw/default
# Timeout da chamada ao gateway. Deve ser MENOR que TURN_TIMEOUT_SEC
# (margem de 30s cobre roteador + overhead do grafo).
ORCHESTRATOR_OPENCLAW_REQUEST_TIMEOUT_SEC=120

# --- n8n (Especialista de Automação, instância externa de produção) ---
ORCHESTRATOR_N8N_URL=https://n8n.example.com
# API key da REST /api/v1 + webhook (header X-N8N-KEY).
ORCHESTRATOR_N8N_API_KEY=
ORCHESTRATOR_N8N_REQUEST_TIMEOUT_SEC=30
# Janela de validade de uma proposta de escrita (create/activate/
# deactivate/delete) aguardando confirmação do usuário (ver
# graph/n8n_confirmation.py). 900s = 15min.
ORCHESTRATOR_N8N_CONFIRMATION_TTL_SEC=900

# --- Roteador / resposta direta (via OpenRouter) ---
ORCHESTRATOR_OPENROUTER_API_KEY=
ORCHESTRATOR_ROUTER_MODEL=deepseek/deepseek-chat
ORCHESTRATOR_GENERAL_MODEL=deepseek/deepseek-chat

# --- Grafo / endpoint síncrono ---
# Trava de loop do supervisor (graph/nodes.py + builder.py).
ORCHESTRATOR_MAX_SUPERVISOR_ITERATIONS=4
# Tempo máximo de /v1/turn antes do fallback 200 (main.py).
ORCHESTRATOR_TURN_TIMEOUT_SEC=150

# --- Checkpointing ---
ORCHESTRATOR_CHECKPOINTER_SQLITE_PATH=./data/checkpoints.sqlite

# --- Observabilidade (LangSmith, desligado por padrão) ---
# main.py faz a ponte ORCHESTRATOR_LANGCHAIN_* -> LANGCHAIN_* (o SDK
# só lê env cru). Sem API key, o tracing segue desligado com warning.
ORCHESTRATOR_LANGCHAIN_TRACING_V2=false
ORCHESTRATOR_LANGCHAIN_API_KEY=
ORCHESTRATOR_LANGCHAIN_PROJECT=orchestrator-portfolio

# Seção 2: compose do orquestrador (orchestrator/docker-compose.yml).
# Imagem publicada (default: build local "meu-agente-orchestrator:local").
ORCHESTRATOR_IMAGE=meu-agente-orchestrator:local
# Diretório do host montado em /app/data (checkpoints SQLite).
ORCHESTRATOR_DATA_DIR=./data
# Porta publicada no host (mapeada para 8000 do container).
ORCHESTRATOR_HOST_PORT=8000
# Rede externa do gateway OpenClaw (para resolver o gateway pelo nome).
ORCHESTRATOR_NETWORK=openclaw_default

# Seção 3: Gateway OpenClaw Node/TS e extensões (lado do gateway,
# fora deste compose — documentado aqui para manter o par
# orquestrador<->gateway consistente).
#
# Cliente do orquestrador no plugin whatsapp-cloud
# (extensions/whatsapp-cloud/src/orchestrator-client.ts):
# URL base do orquestrador vista pelo gateway.
ORCHESTRATOR_URL=http://host.docker.internal:8000
# Timeout do cliente. Deve ficar ACIMA de ORCHESTRATOR_TURN_TIMEOUT_SEC
# (ex.: 150s no grafo -> >=160s aqui), nunca abaixo.
ORCHESTRATOR_TURN_TIMEOUT_MS=160000
# Token enviado pelo cliente como `Authorization: Bearer <token>`
# (orchestrator-client.ts). Deve ser idêntico a ORCHESTRATOR_API_TOKEN
# da Seção 1 acima; ausente/vazio = sem header (só funciona se o
# servidor também estiver sem token, modo dev).
# ORCHESTRATOR_API_TOKEN=
#
# Token de autenticação do gateway (server-side, no .env do host do
# gateway — ex. /root/openclaw/.env no Contabo — e/ou
# gateway-token.json modo 600; NUNCA neste arquivo).
# OPENCLAW_GATEWAY_TOKEN=
#
# Credenciais Meta WhatsApp Cloud (phoneNumberId, verifyToken,
# appSecret, accessToken) vivem na config do plugin em `openclaw.json`
# (plugins.entries.whatsapp-cloud), não em env — ver
# extensions/whatsapp-cloud/src/accounts.ts e channel.ts.
#
# Deploy do gateway no host (nomes usados em /root/openclaw/.env):
# OPENCLAW_IMAGE=openclaw:local
# DOCKER_GID=988
#
# Apenas testes/debug (nunca em produção):
# Porta 1 = suite live (rede/GitHub) de github-repo-report.
# OPENCLAW_LIVE_TEST=0
# Gate de parada parcial do github-repo-report (walk|write|extract).
# GITHUB_REPORT_DEBUG_STOP_AFTER=
