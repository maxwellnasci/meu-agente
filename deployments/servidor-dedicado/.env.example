# =============================================================================
# Molde 1 — Kit Agente Essencial  |  variáveis de ambiente (MODELO)
# =============================================================================
# Este arquivo é um MODELO versionado. Todos os valores são PLACEHOLDERS —
# nenhum segredo, telefone, domínio ou dado de cliente real entra aqui.
#
# Uso na VPS do cliente:
#   cp .env.example .env
#   chmod 600 .env            # <- OBRIGATÓRIO
#   nano .env                 # preencha os valores reais
#
# Por que o chmod 600: o `.env` concentra o access token da Meta, o app
# secret do WhatsApp e o token do tunnel. Em modelo single-tenant a VPS é
# o perímetro de compliance LGPD — o arquivo precisa ser legível apenas
# pelo dono (600), nunca 644/world-readable, e nunca versionado (o
# .gitignore do repo já ignora `**/.env` e `deployments/*`).
#
# Trocou um valor? `docker compose ... restart` NÃO relê o .env:
#   docker compose -f docker-compose.molde1.yml up -d     # recria com o env novo
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Imagens dos containers
# -----------------------------------------------------------------------------
# Tags publicadas no registry em produção (ghcr.io/...), ou build local.
OPENCLAW_IMAGE=openclaw:local-sandboxed-v4
ORCHESTRATOR_IMAGE=meu-agente-orchestrator:local
# Fuso horário do gateway (carimbo de log e agendamentos do agente).
TZ=America/Sao_Paulo


# -----------------------------------------------------------------------------
# 2. Cloudflare Tunnel (único ingress — 100% outbound)
# -----------------------------------------------------------------------------
# Token do conector, obtido em Cloudflare Zero Trust:
#   Networks > Tunnels > Create a tunnel > Cloudflared > copiar o token.
# No tunnel, crie o Public Hostname do cliente (ex.: agente.<cliente>.com.br)
# com o Service apontando para:
#   http://openclaw-gateway:18789
# (nome do serviço na rede `agente-net` — nunca localhost nem IP da VPS).
# Obrigatório e sem default: o compose declara
# `${TUNNEL_TOKEN:?defina TUNNEL_TOKEN no .env}`, então qualquer
# `docker compose up/config` aborta na hora (exit != 0) com a mensagem
# "defina TUNNEL_TOKEN no .env" se a variável estiver ausente OU vazia —
# nada sobe, em vez de deixar o cloudflared em loop de restart.
TUNNEL_TOKEN=


# -----------------------------------------------------------------------------
# 3. WhatsApp Cloud API (credenciais Meta)
# -----------------------------------------------------------------------------
# Estas 4 variáveis são injetadas no container do gateway, mas ATENÇÃO:
# elas NÃO se comportam do mesmo jeito dentro do `openclaw/openclaw.json`.
#
#   accessToken / appSecret / verifyToken  -> aceitam SecretRef "${VAR}"
#     Passam por resolveConfiguredSecretInputString()
#     (src/config/types.secrets.ts, ENV_SECRET_TEMPLATE_RE): o gateway
#     troca "${VAR}" pelo valor da env var em tempo de execução.
#
#   phoneNumberId                          -> NÃO aceita SecretRef "${VAR}"
#     É lido CRU por extensions/whatsapp-cloud/src/accounts.ts, via
#     String(merged.phoneNumberId ?? "").trim(). Um "${VAR}" ali fica
#     como string literal e o agente falha EM SILÊNCIO nos dois sentidos:
#     envio (URL do Graph inválida) e recebimento (webhook recusado por
#     phone_number_id divergente). Exige o número em dígitos literais.
#
# Configuração CORRETA no openclaw.json:
#
#   "channels": {
#     "whatsapp-cloud": {
#       "phoneNumberId": "123456789012345",                      <- LITERAL
#       "accessToken":   "${WHATSAPP_CLOUD_ACCESS_TOKEN}",       <- SecretRef
#       "appSecret":     "${WHATSAPP_CLOUD_APP_SECRET}",         <- SecretRef
#       "verifyToken":   "${WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN}" <- SecretRef
#     }
#   }
#
# Não é preciso copiar o número à mão: o `bootstrap.sh` substitui o
# marcador __WHATSAPP_CLOUD_PHONE_NUMBER_ID__ do `openclaw.json.template`
# pelo valor de WHATSAPP_CLOUD_PHONE_NUMBER_ID deste `.env`. Se você montar
# o openclaw.json manualmente, o número literal é responsabilidade sua.
#
# Nos três campos de SecretRef o segredo fica só no `.env` (600) e o
# openclaw.json pode ser inspecionado/copiado sem credencial em claro.
#
# Access token de System User (permanente). Token temporário de 24h do
# painel só serve para teste — em produção sempre System User.
WHATSAPP_CLOUD_ACCESS_TOKEN=
# ID do número de telefone (Meta > WhatsApp > API Setup), só dígitos.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Token do handshake GET do webhook — string aleatória que você escolhe e
# repete no painel da Meta (ex.: openssl rand -hex 16).
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
# App Secret do app Meta: valida a assinatura X-Hub-Signature-256 de cada
# webhook. Sem ele o gateway aceitaria POST forjado — nunca deixe vazio.
WHATSAPP_CLOUD_APP_SECRET=


# -----------------------------------------------------------------------------
# 4. LLM — OpenRouter (roteador + resposta direta)
# -----------------------------------------------------------------------------
# Chave da API OpenRouter (https://openrouter.ai/keys).
ORCHESTRATOR_OPENROUTER_API_KEY=
# Modelo do roteador (classificação barata de intenção).
ORCHESTRATOR_ROUTER_MODEL=deepseek/deepseek-chat
# Modelo da resposta conversacional direta ao cliente final.
ORCHESTRATOR_GENERAL_MODEL=deepseek/deepseek-chat


# -----------------------------------------------------------------------------
# 5. Orquestrador (cérebro LangGraph) e persistência
# -----------------------------------------------------------------------------
# Escuta dentro do container (não há porta publicada no host).
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
# Autenticação de /v1/turn e /tasks/stream. GERE UM TOKEN em produção:
#   openssl rand -hex 32
# Vazio = modo dev SEM autenticação (o startup emite warning). Precisa ser
# o MESMO valor nos dois containers — o compose já entrega esta variável
# para o orquestrador (servidor) e para o gateway (cliente).
ORCHESTRATOR_API_TOKEN=
# URL do gateway vista DE DENTRO do orquestrador (rede `agente-net`).
ORCHESTRATOR_OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
# Token do gateway visto pelo orquestrador — igual a OPENCLAW_GATEWAY_TOKEN.
ORCHESTRATOR_OPENCLAW_GATEWAY_TOKEN=
# Auth server-side do gateway OpenClaw (openssl rand -hex 32).
OPENCLAW_GATEWAY_TOKEN=
# URL do orquestrador vista DE DENTRO do gateway (rede `agente-net`).
# Nome canônico lido por extensions/whatsapp-cloud/src/orchestrator-client.ts.
# NÃO use host.docker.internal aqui: o molde não tem extra_hosts.
ORCHESTRATOR_URL=http://orchestrator:8000
# Timeout do cliente Node. Deve ficar ACIMA de ORCHESTRATOR_TURN_TIMEOUT_SEC
# (150s no grafo -> 160000ms aqui), nunca abaixo.
ORCHESTRATOR_TURN_TIMEOUT_MS=160000
# Tempo máximo de /v1/turn antes do fallback 200 ao usuário.
ORCHESTRATOR_TURN_TIMEOUT_SEC=150
# Trava de loop do supervisor do grafo.
ORCHESTRATOR_MAX_SUPERVISOR_ITERATIONS=4
# Persistência da memória de conversa (bind mount ./data:/app/data).
# Nome exato lido por config.py (campo `checkpointer_sqlite_path` com
# prefixo ORCHESTRATOR_) — `ORCHESTRATOR_SQLITE_PATH` seria ignorado.
ORCHESTRATOR_CHECKPOINTER_SQLITE_PATH=/app/data/checkpoints.sqlite


# -----------------------------------------------------------------------------
# 6. Modo Atendente e transbordo humano (ask-max)
# -----------------------------------------------------------------------------
# Perfil do orquestrador: "atendente" (conversacional, com transbordo humano
# via ask_human/escalate_to_human) ou "executor" (automação n8n — Molde 2).
ORCHESTRATOR_ATTENDANT_MODE=atendente
# Nome de exibição do operador humano na mensagem de escalonamento.
ORCHESTRATOR_ATTENDANT_OPERATOR_NAME=Operador
# Contato do operador no canal (WhatsApp: DDI+DDD, só dígitos).
# PLACEHOLDER — substituir pelo número real do responsável do cliente.
ORCHESTRATOR_ATTENDANT_OPERATOR_TO=5541999999999
# Canal de entrega do transbordo (id do canal no gateway).
ORCHESTRATOR_ATTENDANT_CHANNEL=whatsapp-cloud
# Conta do canal, quando houver mais de uma (opcional).
ORCHESTRATOR_ATTENDANT_ACCOUNT_ID=
#
# Lado do gateway: o plugin ask-max NÃO lê env — os mesmos valores vão em
# `openclaw/openclaw.json` (plugins.entries.ask-max.config):
#   { "channel": "whatsapp-cloud", "to": "<mesmo número acima>",
#     "operatorName": "Operador", "assistantName": "<nome do agente>" }
# Os dois lados precisam apontar para o MESMO contato.


# -----------------------------------------------------------------------------
# 7. Observabilidade (opcional, desligada por padrão)
# -----------------------------------------------------------------------------
ORCHESTRATOR_LANGCHAIN_TRACING_V2=false
ORCHESTRATOR_LANGCHAIN_API_KEY=
ORCHESTRATOR_LANGCHAIN_PROJECT=orchestrator-portfolio
