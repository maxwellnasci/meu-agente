# Ignora o codigo-fonte do OpenClaw (projeto de terceiros)
openclaw/
# Seguranca extra: ignora qualquer .env em qualquer lugar
**/.env
*.env
# Tokens e segredos locais
gateway-token.json
**/gateway-token.json

# Dados locais / runtime (bancos sqlite, caches, ambientes virtuais)
data/
**/data/
__pycache__/
**/__pycache__/
.venv/
**/.venv/
node_modules/
**/node_modules/
.ruff_cache/
**/.ruff_cache/

# Logs locais
logs/
/*.log

# Scripts de experimento / scratch local (nao sao codigo do projeto)
test_copilot_models.py
scratch.py
scratch_*.py
/scratch/

# Orquestra — arquivos de segurança (nunca enviar ao Git)
.orquestra_vault
.orquestra_salt
