{
  "id": "github-repo-report",
  "activation": {
    "onStartup": false
  },
  "name": "GitHub Repo Report",
  "description": "Fetches and summarizes one allow-listed GitHub repository (read-only, host-process only, never touches the sandbox).",
  "contracts": {
    "tools": ["github_repo_report"],
    "trustedToolPolicies": ["github-repo-report-policy"]
  },
  "toolMetadata": {
    "github_repo_report": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "type": "string",
        "minLength": 1,
        "description": "Default GitHub org/user that owns the configured repos. Used when a repo entry does not set its own owner."
      },
      "repos": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Exact GitHub repo name (case-sensitive)."
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "description": "Overrides the top-level owner for this repo only."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Friendly display name. Defaults to slug."
            },
            "defaultRef": {
              "type": "string",
              "minLength": 1,
              "default": "main"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "required": ["slug"]
        }
      }
    }
  }
}
